<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <module name="TreeWalker">
        <module name="ArrayTypeStyle"/>
        <module name="AvoidStarImport"/>
        <module name="ConstantName">
            <!--Exceptions: underscore followed by lowercase SI unit and a number followed by lowercase x.-->
            <property name="format" value="^[A-Z][A-Z0-9]*(?:_(?:[A-Za-z]+[0-9]+x?|[0-9]+x?|[A-Za-z]+))*$"/>
        </module>
        <module name="DefaultComesLast"/>
        <module name="EmptyStatement"/>
        <module name="IllegalImport">
            <property name="illegalClasses" value="java.util.LinkedList"/>
            <message key="import.illegal"
                     value="LinkedList is almost always the wrong choice; use ArrayList for List usage or ArrayDeque for Queue/Deque usage instead."/>
        </module>
        <module name="IllegalImport">
            <property name="illegalClasses"
                      value="javax.annotation.Nonnull, org.jspecify.annotations.NonNull"/>
            <message key="import.illegal"
                     value="Everything not annotated with @Nullable is assumed to be non-null."/>
        </module>
        <module name="NeedBraces"/>
        <module name="RedundantImport"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="TrailingComment">
            <property name="format" value="^\s*$"/>
        </module>
        <module name="UnusedLocalVariable"/>
        <module name="PackageDeclaration">
            <property name="matchDirectoryStructure" value="true"/>
        </module>
    </module>
</module>